\f0\fs24 \cf0 <!DOCTYPE html>\
<html lang="en">\
<head>\
<meta charset="UTF-8" />\
<meta name="viewport" content="width=device-width, initial-scale=1.0" />\
<title>Sunday Date!</title>\
\
<style>\
body \{\
    margin: 0;\
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;\
    background: linear-gradient(135deg, #ffecd2, #fcb69f);\
    display: flex;\
    justify-content: center;\
    padding: 40px 20px;\
\}\
\
.container \{\
    background: white;\
    max-width: 560px;\
    width: 100%;\
    padding: 40px 30px;\
    border-radius: 20px;\
    box-shadow: 0 25px 60px rgba(0,0,0,0.15);\
    position: relative;\
    overflow: hidden;\
\}\
\
.progress \{\
    height: 8px;\
    background: #eee;\
    border-radius: 10px;\
    margin-bottom: 30px;\
\}\
\
.progress-bar \{\
    height: 8px;\
    width: 0%;\
    background: linear-gradient(to right, #ff6a88, #ff99ac, #fad0c4);\
    transition: width 0.4s ease;\
    border-radius: 10px;\
\}\
\
.section \{ display: none; animation: fade 0.4s ease forwards; \}\
.section.active \{ display: block; \}\
\
h1 \{\
    margin-bottom: 20px;\
    background: linear-gradient(to right, #ff6a88, #ff99ac);\
    -webkit-background-clip: text;\
    -webkit-text-fill-color: transparent;\
\}\
\
.options button \{\
    width: 100%;\
    margin: 8px 0;\
    padding: 14px;\
    border-radius: 14px;\
    border: none;\
    background: linear-gradient(135deg, #ffffff, #f7f7f7);\
    cursor: pointer;\
    transition: all 0.25s ease;\
    font-weight: 500;\
\}\
\
.options button:hover \{\
    background: linear-gradient(135deg, #ff6a88, #ff99ac);\
    color: white;\
    transform: translateY(-3px);\
    box-shadow: 0 8px 20px rgba(255, 105, 135, 0.4);\
\}\
\
input[type="text"] \{\
    width: 100%;\
    padding: 10px;\
    border-radius: 10px;\
    border: 1px solid #ddd;\
    margin-top: 10px;\
\}\
\
.summary \{\
    margin-top: 30px;\
    padding: 20px;\
    background: linear-gradient(135deg, #fdfbfb, #ebedee);\
    border-radius: 15px;\
    white-space: pre-line;\
    font-size: 0.9rem;\
\}\
\
.secret \{\
    display: none;\
    margin-top: 15px;\
    padding: 15px;\
    border-radius: 14px;\
    background: linear-gradient(135deg, #ff6a88, #ff99ac);\
    color: white;\
    animation: pop 0.4s ease;\
\}\
\
.confetti \{\
    position: fixed;\
    width: 10px;\
    height: 10px;\
    top: -10px;\
    animation: fall 2s linear forwards;\
    border-radius: 3px;\
\}\
\
a \{\
    display: inline-block;\
    margin: 5px 0 10px;\
    color: #ff6a88;\
    text-decoration: none;\
    font-weight: 500;\
\}\
\
a:hover \{ text-decoration: underline; \}\
\
@keyframes fade \{\
    from \{ opacity: 0; transform: translateY(10px); \}\
    to \{ opacity: 1; transform: translateY(0); \}\
\}\
\
@keyframes pop \{\
    from \{ transform: scale(0.8); opacity: 0; \}\
    to \{ transform: scale(1); opacity: 1; \}\
\}\
\
@keyframes fall \{\
    to \{ transform: translateY(110vh) rotate(360deg); \}\
\}\
</style>\
</head>\
\
<body>\
\
<div class="container">\
\
<div class="progress">\
    <div class="progress-bar" id="progressBar"></div>\
</div>\
\
<!-- Q1 -->\
<div class="section active" id="q1">\
    <h1>Sunday Date!</h1>\
    <p>Sonya, would you like to go on a date with me?</p>\
    <div class="options">\
        <button onclick="next(1)">Yes</button>\
        <button id="noBtn" onmouseover="moveNo()">No</button>\
    </div>\
</div>\
\
<!-- Q2 -->\
<div class="section" id="q2">\
    <p>Dress code?</p>\
    <div class="options">\
        <button onclick="goDress()">Yes, sure</button>\
        <button onclick="next(3)">No</button>\
    </div>\
</div>\
\
<!-- Q3 -->\
<div class="section" id="q3">\
    <p>Choose the vibe.</p>\
    <div class="options">\
        <button onclick="setDress('Blue and White')">Blue & White</button>\
        <button onclick="setDress('Brown and White / Black')">Brown & White / Black</button>\
    </div>\
\
    <p>Other:</p>\
    <input type="text" id="customDress" placeholder="Type your chosen color(s)" />\
    <button onclick="customDress()">Confirm</button>\
</div>\
\
<!-- Q4 -->\
<div class="section" id="q4">\
    <p>12:30 PM \'97 Admiralty Station.</p>\
    <button onclick="next(4)">Sounds good \uc0\u9989 </button>\
</div>\
\
<!-- Q5 -->\
<div class="section" id="q5">\
    <p>Station 1 \'97 Passepartout \uc0\u9749 </p>\
    <a href="https://maps.app.goo.gl/SXrDoyCa94Wb9Nux5?g_st=ic" target="_blank">View location</a>\
    <div class="options">\
        <button onclick="next(5)">Let\'92s go</button>\
        <button onclick="next(5)">I\'92m in</button>\
    </div>\
</div>\
\
<!-- Q6 -->\
<div class="section" id="q6">\
    <p>Station 2 \'97 Bookstore stop \uc0\u55357 \u56538 </p>\
\
    <a href="https://www.google.com/maps/search/?api=1&query=Hunter+Bookstore+Hong+Kong" target="_blank">\
        Hunter Bookstore (View map)\
    </a>\
    <div class="options">\
        <button onclick="setBook('Hunter Bookstore')">Choose Hunter</button>\
    </div>\
\
    <a href="https://www.google.com/maps/search/?api=1&query=One+Punch+Bookstore+Hong+Kong" target="_blank">\
        One Punch Bookstore (View map)\
    </a>\
    <div class="options">\
        <button onclick="setBook('One Punch Bookstore')">Choose One Punch</button>\
    </div>\
</div>\
\
<!-- Q7 -->\
<div class="section" id="q7">\
    <p>Feeling tired?</p>\
    <p>What about a little cool treat?</p>\
    <button onclick="unlock()">Surprise location \uc0\u10024 </button>\
    <div class="secret" id="secretBox">\
        Surprise unlocked.\
    </div>\
</div>\
\
<!-- Q8 -->\
<div class="section" id="q8">\
    <p>Dinner?</p>\
    <div class="options">\
        <button onclick="finishDinner('Thai food')">Thai food</button>\
        <button onclick="finishDinner('Vietnamese')">Vietnamese</button>\
        <button onclick="finishDinner('Bon can cook (always available at your request)')">\
            Bon can cook (always available at your request)\
        </button>\
    </div>\
</div>\
\
<!-- Q9 -->\
<div class="section" id="q9">\
    <p>If it rains\'85</p>\
    <div class="options">\
        <button onclick="finalize('Still go on the date \'97 rain or shine')">\
            Still go on the date \'97 rain or shine \uc0\u9748 \
        </button>\
        <button onclick="finalize('Stay in and watch a movie')">\
            Stay in and watch a movie \uc0\u55356 \u57260 \
        </button>\
        <button onclick="finalize('Suggest other options (open to discussion)')">\
            Suggest other options (open to discussion)\
        </button>\
    </div>\
</div>\
\
<!-- Final -->\
<div class="section" id="final">\
    <h1>It\'92s a date \uc0\u55357 \u56470 </h1>\
    <p>Sunday, 12:30 PM \'97 Admiralty Station.</p>\
</div>\
\
<div class="summary" id="summary"></div>\
\
</div>\
\
<script>\
let step = 0;\
let itinerary = "";\
\
function updateProgress() \{\
    document.getElementById("progressBar").style.width = (step/9)*100 + "%";\
\}\
\
function show(id) \{\
    document.querySelectorAll(".section").forEach(s=>s.classList.remove("active"));\
    document.getElementById(id).classList.add("active");\
\}\
\
function next(current) \{\
    step = current;\
    updateProgress();\
    show("q"+(current+1));\
\}\
\
function moveNo() \{\
    const btn = document.getElementById("noBtn");\
    btn.style.position = "relative";\
    btn.style.left = Math.random()*80 - 40 + "px";\
\}\
\
function goDress()\{ step=2; updateProgress(); show("q3"); \}\
\
function setDress(choice)\{\
    itinerary += "Dress code: "+choice+"\\n";\
    document.getElementById("summary").innerText = itinerary;\
    next(3);\
\}\
\
function customDress()\{\
    let val = document.getElementById("customDress").value;\
    if(val.trim() !== "")\{\
        setDress(val);\
    \}\
\}\
\
function setBook(store)\{\
    itinerary += "Bookstore: "+store+"\\n";\
    document.getElementById("summary").innerText = itinerary;\
    next(6);\
\}\
\
function unlock()\{\
    document.getElementById("secretBox").style.display="block";\
    setTimeout(()=>next(7),1200);\
\}\
\
function finishDinner(food)\{\
    itinerary += "Dinner: "+food+"\\n";\
    document.getElementById("summary").innerText = itinerary;\
    next(8);\
\}\
\
function finalize(rainPlan)\{\
    itinerary += "Rain plan: "+rainPlan+"\\n";\
    document.getElementById("summary").innerText = itinerary;\
    step=9;\
    updateProgress();\
    show("final");\
    confetti();\
\}\
\
function confetti()\{\
    const colors=["#ff6a88","#ff99ac","#fad0c4","#fbc2eb","#a18cd1","#f6d365"];\
    for(let i=0;i<50;i++)\{\
        let c=document.createElement("div");\
        c.className="confetti";\
        c.style.left=Math.random()*100+"vw";\
        c.style.background=colors[Math.floor(Math.random()*colors.length)];\
        c.style.animationDuration=(Math.random()*1+1.5)+"s";\
        document.body.appendChild(c);\
        setTimeout(()=>c.remove(),2500);\
    \}\
\}\
</script>\
\
</body>\
</html>}